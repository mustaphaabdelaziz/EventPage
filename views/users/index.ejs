<% layout('layouts/boilerplate')%>

<div class="container-fluid mt-4">
  <div class="col m-auto">
    <h3 class="mb-4 text-center text-greenSea fs-1"><%=t("users list")%></h3>
    <!-- <div class="mb-3">
      
    </div> -->

    <form class="d-flex">
      <input id="search" class="form-control mb-2" type="search" placeholder="Search" aria-label="Search" />
    </form>
    <div class="table-responsive">
      <table class="table table-striped table-hover table-borderless text-center sortable">
        <thead class="table-greenSea">
          <tr>
            <th scope="col">N°</th>
            <th scope="col"><%=t("username")%></th>
            <th scope="col"><%=t("email")%></th>
            <th scope="col"><%=t("job")%></th>
            <th scope="col"><%=t("role")%></th>
            <th scope="col"><%=t("last login")%></th>
            <% if (currentUser.privileges.includes("superadmin")){ %>
            <th id="item1" scope="col"><%=t("action")%></th>
            <% }%>
          </tr>
        </thead>
        <tbody id="tablebody">
          <% var i=1 %> <% for (user of users){%>
          <tr>
            <th scope="row"><%= i%><% i=i+1; %></th>
            <td><%= user.fullname %></td>
            <td><%=user.email %></td>
            <td><%=user.job %></td>
            <td><%=user.privileges[0] %></td>

            <td><%=moment(user.loggedIn).format("DD/MM/YYYY-HH:mm:ss") %></td>

            <% if (currentUser.privileges.includes("superadmin")){ %>
            <th>
              <div class="d-flex justify-content-center align-items-center">
                <%- include("./edit")%> <%- include("./delete")%>
              </div>
            </th>
            <% }%>
          </tr>
          <% }%>
        </tbody>
      </table>
    </div>
  </div>
</div>